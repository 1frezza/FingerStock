# Copie para /etc/fingerstock/app.env na EC2 e preencha com os dados do RDS.
# Este arquivo é lido pelo systemd (fingerstock.service) e pelo backup.sh.
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# Endpoint do RDS (Console AWS > RDS > Databases > sua instância > Endpoint)
DB_HOST=fingerstock-db.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=fingerstock
DB_USER=admin
DB_PASSWORD=troque-esta-senha

# Opcional: bucket S3 para onde o backup.sh envia os dumps (deixe vazio para manter só na EC2)
BACKUP_S3_BUCKET=
